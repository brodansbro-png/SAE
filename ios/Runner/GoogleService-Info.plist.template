<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    TEMPLATE — copy to `GoogleService-Info.plist` and fill in.

    Why a template rather than a committed file: `GoogleService-Info.plist`
    identifies a live Firebase project. Committing it would put the project id,
    the API key and the GCM sender id in version control, and anyone with a clone
    could authenticate against the production project.

    Get the real file from:
      Firebase Console → Project settings → Your apps → iOS → GoogleService-Info.plist

    `ios/Runner/GoogleService-Info.plist` is gitignored. The Runner target must
    reference it once it exists; see `docs/RELEASE.md`.
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>REPLACE_WITH_YOUR_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>REPLACE_WITH_YOUR_SENDER_ID</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.sae.absensi</string>
	<key>PROJECT_ID</key>
	<string>REPLACE_WITH_YOUR_PROJECT_ID</string>
	<key>STORAGE_BUCKET</key>
	<string>REPLACE_WITH_YOUR_STORAGE_BUCKET</string>
	<key>GOOGLE_APP_ID</key>
	<string>REPLACE_WITH_YOUR_IOS_APP_ID</string>
	<!-- The iOS client id. `FirebaseConfig` reads this as
	     `FIREBASE_APP_IOS_ID` and passes it to `FirebaseOptions.iosClientId`;
	     without it, Auth rejects the OAuth redirect with
	     `operation-not-allowed`. -->
	<key>CLIENT_ID</key>
	<string>REPLACE_WITH_YOUR_IOS_CLIENT_ID</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>REPLACE_WITH_YOUR_REVERSED_CLIENT_ID</string>
</dict>
</plist>