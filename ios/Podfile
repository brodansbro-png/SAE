# Flutter's iOS platform targets.
#
# Pinned to 15.0 rather than using the `flutter_additional_ios_build_settings`
# comment syntax, because `google_mlkit_face_detection` and `camera` both require
# 15+ for their Swift concurrency usage — a lower floor fails at `pod install`
# with an error that does not name the real cause.
platform :ios, '15.0'

# CocoaPods analytics sends network stats on every build, slowing it down.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # ─── Permissions ─────────────────────────────────────────────────────────────
  #
  # The permission prompts are declared in `Info.plist`, not here. `gcam` is what
  # makes `camera` prompt at runtime; without it the plugin initialises but never
  # asks, and the punch screen sits on "Kamera tidak dapat dibuka" forever.

  # Face detection. Runs fully on-device: no frame leaves the phone, so no data-
  # protection declaration is needed for the model itself.
  pod 'MLKitFaceDetection', :modular_headers => true

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # ─── Bitcode ────────────────────────────────────────────────────────────────
    #
    # Required off. ML Kit ships a large prebuilt binary, and re-running the
    # bitcode toolchain over it is slow enough to dominate the build while
    # producing an artifact the App Store has not required since Xcode 14.
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end

    # ─── Minimum deployment target ───────────────────────────────────────────────
    #
    # Set on every pod, not just the app target. A plugin declaring a lower
    # target than the app produces "the platform of the target Runner (iOS 15.0)
    # is not compatible with Runner (iOS 12.0)" from a pod's own build settings.
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end