# ============================================================
# SAE Flutter App — .env.example
# Salin ke .env dan isi nilainya sebelum menjalankan atau build.
# JANGAN commit .env ke git (sudah ada di .gitignore).
# ============================================================

# ── Firebase (client-side — AMAN untuk mobile) ───────────────────────────────
# Ambil dari Firebase Console → Project Settings → Your apps → Android
# JANGAN masukkan private_key atau service_account di sini (server-only).
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:android:xxxxxxxxxxxx
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# iOS App ID (dari GoogleService-Info.plist → GOOGLE_APP_ID)
FIREBASE_IOS_APP_ID=

# ── Cloudinary (unsigned preset — AMAN untuk mobile) ─────────────────────────
# api_secret TIDAK boleh ada di app mobile. Gunakan unsigned upload preset saja.
# Buat preset: cloudinary.com → Settings → Upload → Upload Presets → Add
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=sae_attendance
CLOUDINARY_LEAVE_PRESET=sae_leave

# ── Aplikasi ──────────────────────────────────────────────────────────────────
APP_NAME=SAE Absensi
APP_ENV=production
